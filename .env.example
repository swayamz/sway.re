# Environment variables for production deployment
# Copy to .env and fill in your values

# Domain configuration
DOMAIN=sway.re
SUBDOMAIN_TIMERS=timers.sway.re

# SSL configuration (set to true when you have certificates)
SSL_ENABLED=false

# Email for Let's Encrypt (required for SSL certificates)
LETSENCRYPT_EMAIL=your-email@example.com

# Database configuration (password will be auto-generated if not provided)
POSTGRES_PASSWORD=your_secure_password_here

# NextAuth Configuration (required for timers app)
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=https://timers.sway.re

# EVE Online SSO Configuration (required for timers app authentication)
# Get these from https://developers.eveonline.com/applications
EVE_CLIENT_ID=your-eve-client-id-from-ccp-developers
EVE_CLIENT_SECRET=your-eve-client-secret-from-ccp-developers

# DigitalOcean configuration (optional, for automated deployment)
DO_TOKEN=your_digitalocean_api_token
DO_DROPLET_NAME=sway-hosting